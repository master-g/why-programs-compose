---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLearningPaths } from '../lib/learning-paths.mjs';
import { withBase } from '../lib/base.mjs';
import { COPY } from '../lib/site-copy.mjs';
import { getEntries } from './_entries.mjs';

const learning = getLearningPaths();
const entries = await getEntries();
const bySlug = new Map(entries.map((entry) => [entry.id.split('/')[1], entry]));

function titleFor(item) {
  return bySlug.get(item.slug)?.data.title || item.slug;
}

function groupBySection(items) {
  const groups = new Map();
  for (const item of items) {
    const key = item.sectionId || 'math-core';
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key).push(item);
  }
  return groups;
}

function sectionName(sectionId) {
  if (sectionId === 'math-core') return learning.math.layers.core?.name_zh || COPY.learn.coreLayerFallback;
  return learning.sections.get(sectionId)?.name_zh || sectionId;
}

function countAvailable(items) {
  return items.filter((item) => item.available && bySlug.has(item.slug)).length;
}

const core = learning.math.layers.core;
const backfill = learning.math.layers.backfill;
const reference = learning.math.layers.reference;
---

<BaseLayout title="学习路径">
  <div class="learning-path-page">
    <nav class="breadcrumbs" aria-label="面包屑">
      <a href={withBase('/')}>全库目录</a><span>/</span><span>学习路径</span>
    </nav>

    <header class="learning-path-header">
      <span class="page-kicker">{COPY.learn.kicker}</span>
      <h1>{COPY.learn.title}</h1>
      <p>{COPY.learn.leadFor(core.entries.length)}</p>
      <blockquote class="epigraph">
        <p>{COPY.learn.epigraph}</p>
        <footer>——本项目学习路径说明</footer>
      </blockquote>
    </header>

    <section class="learning-path-summary" aria-labelledby="learning-path-summary-title">
      <div>
        <span class="page-kicker">阅读合同</span>
        <h2 id="learning-path-summary-title">三种动作</h2>
      </div>
      <ol>
        <li><strong>现在读</strong><span>沿第一遍主线推进。</span></li>
        <li><strong>遇到推导困难时回补</strong><span>{COPY.learn.backfillHint}</span></li>
        <li><strong>按兴趣参考</strong><span>在完成主线后继续理论轨。</span></li>
      </ol>
    </section>

    <section class="learning-path-mainline" aria-labelledby="learning-path-mainline-title">
      <header class="learning-path-section-head">
        <div>
          <span class="page-kicker">现在读 · {learning.path.mainline.entries.length} 篇</span>
          <h2 id="learning-path-mainline-title">第一遍主线</h2>
        </div>
        <p>每个阶段都提供下一篇稳定链接。阶段内的目录只是入口说明，不会改变原章节归属。</p>
      </header>

      {learning.path.mainline.stages.map((stage, stageIndex) => (
        <section class="learning-path-stage" id={`stage-${stage.id}`} aria-labelledby={`stage-${stage.id}-title`}>
          <header class="learning-path-stage__head">
            <span class="learning-path-stage__number">0{stageIndex + 1}</span>
            <div>
              <span class="page-kicker">阶段 {stageIndex + 1} · {stage.entries.length} 篇</span>
              <h3 id={`stage-${stage.id}-title`}>{stage.name_zh}</h3>
              <p class="newthought">{stage.goal_zh}</p>
            </div>
          </header>

          {stage.kind === 'core-math' ? (
            <div class="learning-path-math-groups">
              {core.groups.map((group) => (
                <section class="learning-path-math-group" aria-labelledby={`math-group-${group.id}`}>
                  <header>
                    <h4 id={`math-group-${group.id}`}>{group.name_zh}</h4>
                    <span>{group.entries.length} 篇</span>
                  </header>
                  <ol>
                    {group.entries.map((item) => (
                      <li>
                        {bySlug.has(item.slug)
                          ? <a href={withBase(`/${item.slug}/`)}>{titleFor(item)}</a>
                          : <span>{item.slug}</span>}
                        <p><strong>现在为什么需要：</strong>{item.why_now_zh}</p>
                        <p><strong>阅读目标：</strong>{item.reading_goal_zh}</p>
                        <small>首次用途：{titleFor({ slug: item.first_use })}</small>
                      </li>
                    ))}
                  </ol>
                </section>
              ))}
            </div>
          ) : (
            <div class="learning-path-section-groups">
              {[...groupBySection(stage.entries)].map(([sectionId, sectionEntries]) => (
                <details class="learning-path-section-disclosure" open={stageIndex === 1}>
                  <summary>
                    <span>{sectionName(sectionId)}</span>
                    <small>{countAvailable(sectionEntries)} / {sectionEntries.length} 篇</small>
                  </summary>
                  <ol>
                    {sectionEntries.map((item) => (
                      <li>
                        {item.available && bySlug.has(item.slug)
                          ? <a href={withBase(`/${item.slug}/`)}>{titleFor(item)}</a>
                          : <span class="entry-todo">{item.slug} · TODO</span>}
                      </li>
                    ))}
                  </ol>
                </details>
              ))}
            </div>
          )}
        </section>
      ))}
    </section>

    {(backfill.entries.length > 0 || reference.entries.length > 0 || learning.path.optionalBranches.length > 0) && (
    <section class="learning-path-secondary" aria-labelledby="learning-path-secondary-title">
      <header class="learning-path-section-head">
        <div>
          <span class="page-kicker">不计入主线进度</span>
          <h2 id="learning-path-secondary-title">回补与参考</h2>
        </div>
        <p>这些入口保留完整记号地图，但不会插入主线的前后关系。</p>
      </header>

      {backfill.entries.length > 0 && (
      <details class="learning-path-disclosure" open>
        <summary><span>遇到推导困难时回补 · {backfill.entries.length} 篇</span></summary>
        <div class="learning-path-card-grid">
          {backfill.groups.map((group) => (
            <section class="learning-path-card" aria-labelledby={`backfill-${group.id}`}>
              <h3 id={`backfill-${group.id}`}>{group.name_zh}</h3>
              <p>{group.purpose_zh}</p>
              <ol>
                {group.entries.map((item) => (
                  <li>
                    {bySlug.has(item.slug)
                      ? <a href={withBase(`/${item.slug}/`)}>{titleFor(item)}</a>
                      : <span class="entry-todo">{item.slug} · TODO</span>}
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      </details>
      )}

      {reference.entries.length > 0 && (
      <details class="learning-path-disclosure">
        <summary><span>按兴趣参考 · {reference.entries.length} 篇</span><small>进阶记号</small></summary>
        <ol class="learning-path-reference-list">
          {reference.entries.map((item) => (
            <li>
              {item.available && bySlug.has(item.slug)
                ? <a href={withBase(`/${item.slug}/`)}>{titleFor(item)}</a>
                : <span class="entry-todo">{item.slug} · TODO</span>}
            </li>
          ))}
        </ol>
      </details>
      )}

      {learning.path.optionalBranches.map((branch) => (
        <details class="learning-path-disclosure">
          <summary><span>可选支线 · {branch.name_zh}</span><small>{branch.entries.length} 篇</small></summary>
          <p>{branch.description_zh}</p>
          <ol class="learning-path-reference-list">
            {branch.entries.map((item) => (
              <li>
                {item.available && bySlug.has(item.slug)
                  ? <a href={withBase(`/${item.slug}/`)}>{titleFor(item)}</a>
                  : <span class="entry-todo">{item.slug} · TODO</span>}
              </li>
            ))}
          </ol>
        </details>
      ))}
    </section>
    )}

    <footer class="learning-path-footer">
      <a class="button-primary" href={withBase(`/category/${COPY.learn.footerCta.sectionDir}/`)}>{COPY.learn.footerCta.label}</a>
      <a class="button-secondary" href={withBase('/')}>返回全库目录</a>
    </footer>
  </div>
</BaseLayout>
