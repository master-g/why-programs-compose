---
import SearchBox from '../components/SearchBox.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/site.css';
import { withBase } from '../lib/base.mjs';
import { SITE, REPO_URL, THEME_STORAGE_KEY } from '../lib/site.config.mjs';

type ActiveNav = 'learn' | 'catalog' | 'glossary' | 'about';

const navItems: ReadonlyArray<{ id: ActiveNav; href: string; label: string }> = [
  { id: 'learn', href: withBase('/learn/'), label: '学习路径' },
  { id: 'catalog', href: withBase('/'), label: '全库目录' },
  { id: 'glossary', href: withBase('/glossary/'), label: '词汇表' },
  { id: 'about', href: withBase('/about/'), label: '关于' },
];

export interface Props {
  activeNav?: ActiveNav;
  lang?: string;
  /** 页名,不含品牌后缀;省略时只用品牌名(首页之外都应给值)。 */
  title?: string;
}
const { activeNav: activeNavProp, lang = 'zh-CN', title } = Astro.props;
// 「页名 | 品牌」是全站 title 口径,后缀在这里统一拼,页面只给页名。
const documentTitle = title ? `${title} | ${SITE.brandZh}` : SITE.brandZh;
const currentPath = Astro.url.pathname;
const activeNav = activeNavProp
  ?? (currentPath.startsWith(withBase('/category/'))
    ? 'catalog'
    : navItems.find((item) => item.href === currentPath)?.id);
const navCurrent = (item: ActiveNav) => activeNav === item ? 'page' : undefined;
---

<!DOCTYPE html>
<html lang={lang} data-theme="white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{documentTitle}</title>
    <script is:inline define:vars={{ themeKey: THEME_STORAGE_KEY }}>
      (() => {
        try {
          const saved = localStorage.getItem(themeKey);
          if (saved === 'black') document.documentElement.dataset.theme = 'black';
        } catch (_) {
          // 本地文件预览可能禁用 storage。
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>

    <header class="site-header">
      <div class="site-header__inner">
        <div class="site-header__discovery">
          <a class="site-brand" href={withBase('/')} aria-label={`${SITE.brandZh}首页`}>
            <span class="site-brand__name">{SITE.brandZh}</span>
            <span class="site-brand__tagline">{SITE.taglineZh}</span>
          </a>
          <SearchBox variant="desktop" />
        </div>

        <nav class="site-nav" aria-label="主导航">
          {navItems.map((item) => (
            <a href={item.href} aria-current={navCurrent(item.id)}>{item.label}</a>
          ))}
          <a class="site-nav__external" href={REPO_URL} target="_blank" rel="noopener noreferrer" aria-label="GitHub 仓库">
            <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          </a>
          <ThemeToggle />
        </nav>

        <div class="site-mobile-actions">
          <button class="site-search-trigger" type="button" aria-label="打开搜索" title="搜索" data-mobile-search-trigger>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
          </button>

          <details class="site-menu">
            <summary aria-label="展开导航" aria-expanded="false"><span></span><span></span><span></span></summary>
            <div class="site-menu__panel">
              <SearchBox variant="mobile" />
              {navItems.map((item) => (
                <a href={item.href} aria-current={navCurrent(item.id)}>{item.label}</a>
              ))}
              <a href={REPO_URL} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
              <div class="site-menu__appearance">
                <span>主题</span>
                <ThemeToggle />
              </div>
            </div>
          </details>
        </div>
      </div>
    </header>

    <main id="main-content" class="site-shell">
      <slot />
    </main>

    <footer class="site-footer">
      <span>{SITE.brandZh} · 独立界面与中文排版</span>
      <span>正文与原创插图采用 <a href={SITE.contentLicense.url}>{SITE.contentLicense.id}</a></span>
    </footer>

    <script is:inline define:vars={{ themeKey: THEME_STORAGE_KEY }}>
      (() => {
        const root = document.documentElement;
        const themeToggles = Array.from(document.querySelectorAll('[data-theme-toggle]'));
        const menu = document.querySelector('.site-menu');
        const menuSummary = menu?.querySelector('summary');
        const mobileSearchTrigger = document.querySelector('[data-mobile-search-trigger]');

        function setTheme(theme, persist = true) {
          const next = theme === 'black' ? 'black' : 'white';
          const isBlack = next === 'black';
          const label = isBlack ? '切换到白色主题' : '切换到黑色主题';
          root.dataset.theme = next;
          themeToggles.forEach((button) => {
            button.setAttribute('aria-checked', String(isBlack));
            button.setAttribute('aria-label', label);
            button.setAttribute('title', label);
          });
          if (persist) {
            try { localStorage.setItem(themeKey, next); } catch (_) {}
          }
        }

        setTheme(root.dataset.theme, false);
        themeToggles.forEach((button) => {
          button.addEventListener('click', () => {
            setTheme(root.dataset.theme === 'black' ? 'white' : 'black');
          });
        });

        function syncMenuState() {
          if (!menu || !menuSummary) return;
          const isOpen = menu.open;
          menuSummary.setAttribute('aria-expanded', String(isOpen));
          menuSummary.setAttribute('aria-label', isOpen ? '收起导航' : '展开导航');
        }

        function focusMobileSearch() {
          if (!menu) return;
          menu.open = true;
          syncMenuState();
          window.setTimeout(() => {
            menu.querySelector('[data-search-role="input"]')?.focus();
          }, 0);
        }

        menu?.addEventListener('toggle', syncMenuState);
        menu?.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => { menu.open = false; });
        });
        mobileSearchTrigger?.addEventListener('click', focusMobileSearch);
        syncMenuState();

        document.addEventListener('click', (event) => {
          if (!menu?.open) return;
          if (menu.contains(event.target) || mobileSearchTrigger?.contains(event.target)) return;
          menu.open = false;
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && menu?.open) {
            event.preventDefault();
            menu.open = false;
            menuSummary?.focus();
            return;
          }

          if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
            event.preventDefault();
            if (window.matchMedia('(max-width: 900px)').matches) {
              focusMobileSearch();
              return;
            }
            document.querySelector('.site-header__discovery [data-search-role="input"]')?.focus();
          }
        });
      })();
    </script>
  </body>
</html>
