---
// 本页大纲:宽屏(≥1360px)常驻右栏 + 中屏(1040–1359px)收纳 pill。
// 数据来自 render(entry) 的 headings(只取 h2);少于 2 个 h2 不渲染。
// 无 JS 时:右栏是纯锚点列表照常可用;pill 靠 <details> 原生开合。
// 滚动高亮由下方内联脚本渐进增强,采用「阅读线以上最后一个标题」语义。
const { headings = [] } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2);
---

{items.length > 1 && (
  <>
    <nav class="article-outline article-outline--rail" aria-label="本页大纲">
      <span class="article-outline__marker" aria-hidden="true"></span>
      <span class="article-outline__title">本页大纲</span>
      <ol>
        {items.map((heading) => (
          <li><a href={`#${heading.slug}`} data-outline-link={heading.slug}>{heading.text}</a></li>
        ))}
      </ol>
    </nav>

    <details class="article-outline article-outline--pill">
      <summary><span data-outline-current>本页大纲</span></summary>
      <ol>
        {items.map((heading) => (
          <li><a href={`#${heading.slug}`} data-outline-link={heading.slug}>{heading.text}</a></li>
        ))}
      </ol>
    </details>

    <script is:inline>
      (() => {
        // 组件在 DOM 中位于正文之前,必须等 h2 解析完再取。
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }

        function init() {
        const links = Array.from(document.querySelectorAll('[data-outline-link]'));
        if (!links.length) return;
        const ids = [...new Set(links.map((link) => link.dataset.outlineLink))];
        const heads = ids.map((id) => document.getElementById(id)).filter(Boolean);
        if (!heads.length) return;
        const currentLabel = document.querySelector('[data-outline-current]');
        const pill = document.querySelector('.article-outline--pill');
        const marker = document.querySelector('.article-outline__marker');
        let activeId = '';
        let ticking = false;

        function setActive(id) {
          if (id === activeId) return;
          activeId = id;
          for (const link of links) {
            link.classList.toggle('is-active', link.dataset.outlineLink === id);
          }
          const index = ids.indexOf(id);
          if (currentLabel && index >= 0) {
            currentLabel.textContent = `${heads[index].textContent} · ${index + 1}/${heads.length}`;
          }
          const railLink = links.find(
            (link) => link.dataset.outlineLink === id && link.closest('.article-outline--rail'),
          );
          if (marker && railLink) {
            marker.style.transform = `translateY(${railLink.offsetTop}px)`;
            marker.style.height = `${railLink.offsetHeight}px`;
          }
        }

        function update() {
          ticking = false;
          let current = heads[0].id;
          for (const head of heads) {
            if (head.getBoundingClientRect().top <= 140) current = head.id;
          }
          setActive(current);
        }

        addEventListener('scroll', () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(update);
        }, { passive: true });

        pill?.addEventListener('click', (event) => {
          if (event.target.closest('a')) pill.open = false;
        });

        update();
        }
      })();
    </script>
  </>
)}
